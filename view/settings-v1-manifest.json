            },
            {
              "id": "sidebarWidth",
              "label": "Category column width",
              "type": "integer",
              "min": 160,
              "max": 380,
              "step": 10
            },
            {
              "id": "questListWidth",
              "label": "Quest list width",
              "type": "integer",
              "min": 240,
              "max": 560,
              "step": 10
            }
          ]
        }
      ]
    },
