        {
          "id": "custom-palette",
          "title": "Custom palette",
          "fields": [
            {
              "id": "journalAccent",
              "label": "Accent color",
              "type": "color",
              "advanced": true,
              "help": "Used when the journal theme is Custom Colors; changing themes preserves this value."
            },
            {
              "id": "journalText",
              "label": "Text color",
              "type": "color",
              "advanced": true,
              "help": "Used when the journal theme is Custom Colors; changing themes preserves this value."
            },
            {
              "id": "journalPanel",
              "label": "Panel background",
              "type": "color",
              "advanced": true,
              "help": "Used when the journal theme is Custom Colors; changing themes preserves this value."
            },
            {
              "id": "journalCompleted",
              "label": "Completed objectives",
              "type": "color",
              "advanced": true,
              "help": "Used when the journal theme is Custom Colors; changing themes preserves this value."
            }
          ]
        }
      ]
    },
    {
      "id": "journal-layout",
      "title": "Journal layout",
      "groups": [
        {
          "id": "columns",
          "title": "Quest list",
          "fields": [
            {
              "id": "density",
