{
  "manifestVersion": 1,
  "moduleId": "quest-journal",
  "title": "Quest Journal",
  "nativeSettingsSchemaVersion": 1,
  "categories": [
    {
      "id": "general",
      "title": "General",
      "groups": [
        {
          "id": "tracker-availability",
          "title": "Compact tracker",
          "fields": [
            {
              "id": "trackerEnabled",
              "label": "Show compact tracker",
              "type": "toggle"
            },
            {
              "id": "trackerOverridePhosphor",
              "label": "Allow compact tracker with Phosphor HUD",
              "type": "toggle",
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              },
              "help": "Quest Journal only controls its own tracker. Phosphor HUD's tracker may still be visible."
            }
          ]
        }
      ]
    },
    {
      "id": "tracker-layout",
      "title": "Tracker layout",
      "groups": [
        {
          "id": "placement",
          "title": "Placement and size",
          "fields": [
            {
              "id": "trackerAnchor",
              "label": "Screen position",
              "type": "select",
              "options": [
                {
                  "value": "top-right",
                  "label": "Top right"
                },
                {
                  "value": "top-left",
                  "label": "Top left"
                },
                {
                  "value": "bottom-right",
                  "label": "Bottom right"
                },
                {
                  "value": "bottom-left",
                  "label": "Bottom left"
                }
              ],
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              },
              "help": "Legacy corner placement. Changing this exits custom live layout; use Edit this mod HUD layout in the Appearance category to position freely."
            },
            {
              "id": "trackerWidth",
              "label": "Tracker width",
              "type": "integer",
              "min": 260,
              "max": 520,
              "step": 10,
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              },
              "help": "Legacy width control. Changing this exits custom live layout; use Edit this mod HUD layout to resize proportionally."
            },
            {
              "id": "trackerMaxQuests",
              "label": "Maximum visible quests",
              "type": "integer",
              "min": 1,
              "max": 12,
              "step": 1,
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              }
            }
          ]
        },
        {
          "id": "quest-selection",
          "title": "Displayed quests",
          "fields": [
            {
              "id": "trackerShowCompleted",
              "label": "Show completed objectives",
              "type": "toggle",
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              }
            },
            {
              "id": "trackerAutoPinNew",
              "label": "Automatically pin newly received quests",
              "type": "toggle",
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              },
              "help": "Does not pin quests present during the save's initial scan."
            }
          ]
        }
      ]
    },
    {
      "id": "tracker-appearance",
      "title": "Tracker appearance",
      "groups": [
        {
          "id": "preset",
          "title": "Theme and scale",
          "fields": [
            {
              "id": "theme",
              "label": "Tracker theme",
              "type": "select",
              "options": [
                {
                  "value": "commonwealth",
                  "label": "Commonwealth Blue"
                },
                {
                  "value": "pipboy",
                  "label": "Classic Pip-Boy"
                },
                {
                  "value": "contrast",
                  "label": "High Contrast"
                },
                {
                  "value": "fallout76",
                  "label": "Fallout 76"
                },
                {
                  "value": "custom",
                  "label": "Custom Colors"
                }
              ],
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              },
              "advanced": true,
              "help": " Preserved legacy appearance setting; the unified theme override controls the shared visual style."
            },
            {
              "id": "trackerOpacity",
              "label": "Background opacity",
              "type": "integer",
              "min": 25,
              "max": 100,
              "step": 1,
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              }
            },
            {
              "id": "trackerScale",
              "label": "Text scale",
              "type": "integer",
              "min": 75,
              "max": 150,
              "step": 5,
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              }
            }
          ]
        },
        {
          "id": "custom-palette",
          "title": "Custom palette",
          "fields": [
            {
              "id": "accent",
              "label": "Accent color",
              "type": "color",
              "advanced": true,
              "help": "Used when the tracker theme is Custom Colors; changing themes preserves this value.",
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              }
            },
            {
              "id": "text",
              "label": "Text color",
              "type": "color",
              "advanced": true,
              "help": "Used when the tracker theme is Custom Colors; changing themes preserves this value.",
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              }
            },
            {
              "id": "panel",
              "label": "Panel background",
              "type": "color",
              "advanced": true,
              "help": "Used when the tracker theme is Custom Colors; changing themes preserves this value.",
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              }
            },
            {
              "id": "completed",
              "label": "Completed objectives",
              "type": "color",
              "advanced": true,
              "help": "Used when the tracker theme is Custom Colors; changing themes preserves this value.",
              "visibleWhen": {
                "all": [
                  "trackerEnabled"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "journal-appearance",
      "title": "Journal appearance",
      "groups": [
        {
          "id": "preset",
          "title": "Theme and scale",
          "fields": [
            {
              "id": "journalTheme",
              "label": "Journal theme",
              "type": "select",
              "options": [
                {
                  "value": "dark",
                  "label": "Commonwealth Blue"
                },
                {
                  "value": "pipboy",
                  "label": "Classic Pip-Boy"
                },
                {
                  "value": "contrast",
                  "label": "High Contrast"
                },
                {
                  "value": "fallout76",
                  "label": "Fallout 76"
                },
                {
                  "value": "custom",
                  "label": "Custom Colors"
                }
              ],
              "advanced": true,
              "help": " Preserved legacy appearance setting; the unified theme override controls the shared visual style."
            },
            {
              "id": "journalOpacity",
              "label": "Background opacity",
              "type": "integer",
              "min": 25,
              "max": 100,
              "step": 1
            },
            {
              "id": "journalFontSize",
              "label": "Text scale",
              "type": "integer",
              "min": 75,
              "max": 150,
              "step": 5
            }
