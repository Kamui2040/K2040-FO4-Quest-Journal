{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:k2040:settings:manifest:v1",
  "title": "K2040 Settings Definition Manifest v1",
  "description": "Declarative UI metadata. Saved values, default values, validation and side effects remain owned by each module; manifests are never direct writes to INI/MCM.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "moduleId",
    "title",
    "nativeSettingsSchemaVersion",
    "categories"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "moduleId": {
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "nativeSettingsSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "internalKeys": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(?:[._-][a-zA-Z0-9]+)*$",
      "maxLength": 100
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "integer"
            }
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "enum": [
            "toggle",
            "integer",
            "number",
            "select",
            "color",
            "marker-style",
            "action",
            "keybind"
          ]
        },
        "help": {
          "type": "string",
          "maxLength": 700
        },
        "advanced": {
          "type": "boolean"
        },
        "visibleWhen": {
          "$ref": "#/$defs/visibility"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "actionId": {
          "$ref": "#/$defs/identifier"
        },
        "owner": {
          "enum": [
            "module",
            "mcm"
          ]
        },
        "preview": {
          "enum": [
            "attachment-layout"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "integer",
                  "number"
                ]
              }
            }
          },
          "then": {
            "required": [
              "min",
              "max",
              "step"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "variants"
                  ]
                },
                {
                  "required": [
                    "actionId"
                  ]
                },
                {
                  "required": [
                    "owner"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                },
                {
                  "required": [
                    "variants"
                  ]
                },
                {
                  "required": [
                    "actionId"
                  ]
                },
                {
                  "required": [
                    "owner"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "marker-style"
              }
            }
          },
          "then": {
            "required": [
              "variants"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                },
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "actionId"
                  ]
                },
                {
                  "required": [
                    "owner"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "action"
              }
            }
          },
          "then": {
            "required": [
              "actionId",
              "owner"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                },
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "variants"
                  ]
                },
                {
                  "required": [
                    "visibleWhen"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "toggle",
                  "color"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                },
                {
                  "required": [
                    "options"
                  ]
                },
                {
                  "required": [
                    "variants"
                  ]
                },
                {
                  "required": [
                    "actionId"
                  ]
                },
                {
                  "required": [
                    "owner"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 150,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "groups"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    }
  }
}
